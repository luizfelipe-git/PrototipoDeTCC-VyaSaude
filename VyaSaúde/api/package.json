{
  "name": "tcc_back",
  "version": "1.0.0",
  "description": "Back-End do Projeto de TCC",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev:local": "cross-env NODE_ENV=local nodemon --env-file=.env.local -r dotenv/config src/index.js",
    "dev:cloud": "cross-env NODE_ENV=production nodemon --env-file=.env.production -r dotenv/config src/index.js",
    "start": "bun i && bun audit fix && nodemon -r dotenv/config src/index.js",
    "generate_migration": "npx typeorm -d ./src/database/data-source.js migration:generate ./src/database/migrations/db --outputJs",
    "run_migrations": "npx typeorm -d ./src/database/data-source.js migration:run"
  },
  "author": "Raul Tomaz",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cpf-cnpj-validator": "^2.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1",
    "nodemailer": "^9.0.3",
    "reflect": "^0.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.24",
    "zod": "^4.1.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
